# Только локальная демонстрация. Compose работает и без этого файла.
HTTP_PORT=8080
POSTGRES_PORT=54329
POSTGRES_PASSWORD=local-demo-password
CONFIRMATIONS=3
LOCAL_MOCKS=true
MOCK_CONTROL_KEY=local-control-key
AML_RETRY_INTERVAL=5s
AML_BLACKLIST=0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
AML_UNAVAILABLE=false
REFUNDS_ENABLED=true
REFUND_UNSAFE_SENDERS=
PARTNER_ALPHA_KEY=local-alpha-key
PARTNER_BETA_KEY=local-beta-key
